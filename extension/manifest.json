{
  "manifest_version": 3,
  "name": "Chuddy — the browser sidekick",
  "version": "0.2.0",
  "description": "Pair with local Chuddy to close selected focused work tabs and open the casino during an enabled session. Starts disabled.",
  "minimum_chrome_version": "120",
  "permissions": ["storage", "tabs", "alarms"],
  "host_permissions": ["http://127.0.0.1/*", "http://localhost/*"],
  "background": {"service_worker": "worker.js"},
  "action": {"default_popup": "popup.html", "default_title": "Chuddy browser sidekick"},
  "options_page": "popup.html",
  "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}
}
